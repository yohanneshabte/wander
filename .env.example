# Copy to .env.local. Never commit real values.
# Preview on grok.me injects these. A self-host needs them.

# Postgres. Empty = PGLite (local demo only).
DATABASE_URL=

# Better Auth session signing. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Grok / Google / X OAuth. Leave empty for email-password-only local.
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
GROK_PREVIEW_CLIENT_SECRET=

# Optional: grounded benefit chat
XAI_API_KEY=

# Auth on/off. Deployed grok.me always on.
VITE_AUTH_ENABLED=true

# Demo desk codes — CHANGE these before a real house uses the app.
WANDER_DESK_CODE=desk-a
WANDER_OWNER_CODE=desk-b
# Comma pairs: code:listingId
WANDER_STORE_CODES=desk-c:store-1,desk-d:store-2,desk-e:store-3
